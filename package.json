{
  "name": "trip-manager",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "concurrently -n web,worker -c green,cyan \"next dev\" \"tsx watch --env-file-if-exists=.env.local src/worker/index.ts\"",
    "worker": "tsx --env-file-if-exists=.env.local src/worker/index.ts",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "airports": "tsx scripts/fetch-airports.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/db/seed/scenario-martin.ts",
    "test": "vitest",
    "claude:image": "docker build -t planytrip-claude docker/claude",
    "model:train": "uv run tools/price-model/train.py"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@paralleldrive/cuid2": "^3.3.0",
    "@tanstack/react-query": "^5.104.4",
    "better-sqlite3": "^13.0.3",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.5.0",
    "d3-geo": "^3.1.1",
    "drizzle-orm": "^0.45.4",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "playwright": "^1.64.1",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "shadcn": "^4.22.1",
    "topojson-client": "^3.1.0",
    "tw-animate-css": "^1.4.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/better-sqlite3": "^9.6.0",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.5",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "concurrently": "^10.0.6",
    "drizzle-kit": "^0.31.11",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
